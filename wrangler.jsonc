{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autofeed-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "env": {
    "development": {
      "secrets": {
        "required": [
          "LINKEDIN_CLIENT_SECRET",
          "DATABASE_URL",
          "RUNPOD_API_KEY",
          "AUTOFEED_SESSION_SECRET"
        ]
      },
      "vars": {
        "LINKEDIN_REDIRECT_URI": "https://dev-api.autofeed.io/linkedin/authorizationCallback",
        "LINKEDIN_CLIENT_ID": "86esd8heytrkhm",
        "ALLOWED_ORIGINS": "https://autofeed.io|https://www.autofeed.io|http://localhost:3000|http://localhost:5173",
        "LINKEDIN_ALLOWED_RETURN_URIS": "com.autofeed.dev.linkedin://oauthredirect|com.autofeed.linkedin://oauthredirect|autofeed://linkedin/oauthredirect",
        "CONTENT_LINKEDIN_AUTO_POST_SCHEDULE": "off",
        "CONTENT_LINKEDIN_AUTO_POST_SECTIONS": "tech-memes|news",
        "CONTENT_LINKEDIN_MEME_SUBREDDITS": "ProgrammerHumor|programmingmemes|ProgrammerDadJokes|programmerreactions|linuxmemes|webdevmemes|sysadminhumor|iiiiiiitttttttttttt|softwaregore",
        "CONTENT_LINKEDIN_REDDIT_SUBREDDITS": "worldnews|news|geopolitics|india|IndianPolitics|IndianModerate|unitedstatesofindia|business|economics|technology|science|UpliftingNews",
        "CONTENT_LINKEDIN_REDDIT_USER_AGENT": "script:linkedin-news:v1.0 (by /u/YOUR_REDDIT_USERNAME)",
        "CONTENT_LINKEDIN_RUNPOD_ENDPOINT_ID": "qexf1iafzz41nh",
        "CONTENT_LINKEDIN_RUNPOD_MODEL": "Qwen2.5-VL-32B-Instruct",
        "CONTENT_LINKEDIN_RUNPOD_MAX_NEW_TOKENS": "650",
        "CONTENT_LINKEDIN_RUNPOD_TEMPERATURE": "0.2",
        "CONTENT_LINKEDIN_RUNPOD_POLL_TIMEOUT_MS": "45000",
        "CONTENT_LINKEDIN_RUNPOD_POLL_INTERVAL_MS": "5000",
        "DEPENDENCY_NEON_FORCE_DOWN": "true",
        "DEPENDENCY_NEON_FORCE_DOWN_REASON": "Neon monthly compute allowance is exhausted"
      },
      "routes": [
        {
          "pattern": "dev-api.autofeed.io/*",
          "zone_name": "autofeed.io"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONTENT_SCHEDULER_STATE",
          "id": "51a21fa996594b17b94d50be838cda0a"
        }
      ]
    },
    "production": {
      "secrets": {
        "required": [
          "LINKEDIN_CLIENT_SECRET",
          "DATABASE_URL",
          "RUNPOD_API_KEY",
          "AUTOFEED_SESSION_SECRET"
        ]
      },
      "vars": {
        "LINKEDIN_REDIRECT_URI": "https://api.autofeed.io/linkedin/authorizationCallback",
        "LINKEDIN_CLIENT_ID": "86esd8heytrkhm",
        "ALLOWED_ORIGINS": "https://autofeed.io|https://www.autofeed.io",
        "LINKEDIN_ALLOWED_RETURN_URIS": "com.autofeed.linkedin://oauthredirect|autofeed://linkedin/oauthredirect",
        "CONTENT_LINKEDIN_AUTO_POST_SCHEDULE": "off",
        "CONTENT_LINKEDIN_AUTO_POST_SECTIONS": "tech-memes|news",
        "CONTENT_LINKEDIN_MEME_SUBREDDITS": "ProgrammerHumor|programmingmemes|ProgrammerDadJokes|programmerreactions|linuxmemes|webdevmemes|sysadminhumor|iiiiiiitttttttttttt|softwaregore",
        "CONTENT_LINKEDIN_REDDIT_SUBREDDITS": "worldnews|news|geopolitics|india|IndianPolitics|IndianModerate|unitedstatesofindia|business|economics|technology|science|UpliftingNews",
        "CONTENT_LINKEDIN_REDDIT_USER_AGENT": "script:linkedin-news:v1.0 (by /u/YOUR_REDDIT_USERNAME)",
        "CONTENT_LINKEDIN_RUNPOD_ENDPOINT_ID": "qexf1iafzz41nh",
        "CONTENT_LINKEDIN_RUNPOD_MODEL": "Qwen2.5-VL-32B-Instruct",
        "CONTENT_LINKEDIN_RUNPOD_MAX_NEW_TOKENS": "650",
        "CONTENT_LINKEDIN_RUNPOD_TEMPERATURE": "0.2",
        "CONTENT_LINKEDIN_RUNPOD_POLL_TIMEOUT_MS": "45000",
        "CONTENT_LINKEDIN_RUNPOD_POLL_INTERVAL_MS": "5000"
      },
      "routes": [
        {
          "pattern": "api.autofeed.io/*",
          "zone_name": "autofeed.io"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONTENT_SCHEDULER_STATE",
          "id": "f855c6737c6348488bb54a0f92c510e2"
        }
      ]
    }
  }
}
